# Used by the Next.js process. Local development connects directly to PostgreSQL.
DATABASE_URL=postgresql://read_buddy:read_buddy_dev@localhost:5432/read_buddy
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
# Production only when the database endpoint uses a private certificate authority.
DATABASE_CA_CERT=

# Used by Docker Compose. Replace all production values through the host's secret store.
POSTGRES_DB=read_buddy
POSTGRES_USER=read_buddy
POSTGRES_PASSWORD=read_buddy_dev
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
# Production host directory containing server.crt and server.key.
PGBOUNCER_CERT_DIR=./infra/pgbouncer/certs

# Clerk authentication. Keep CLERK_SECRET_KEY server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Reminders (phase 7). Resend API key from https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Cron secret for authenticated reminder dispatch (generate with: openssl rand -base64 32)
CRON_SECRET=

# Public app URL for email links
NEXT_PUBLIC_APP_URL=http://localhost:3000
