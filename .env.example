# Used by the Next.js process. Local development connects directly to PostgreSQL.
DATABASE_URL=postgresql://read_buddy:read_buddy_dev@localhost:5432/read_buddy
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
# Production only when the database endpoint uses a private certificate authority.
DATABASE_CA_CERT=

# Used by Docker Compose. Replace all production values through the host's secret store.
POSTGRES_DB=read_buddy
POSTGRES_USER=read_buddy
POSTGRES_PASSWORD=read_buddy_dev
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
# Production host directory containing server.crt and server.key.
PGBOUNCER_CERT_DIR=./infra/pgbouncer/certs

# Reserved for the database/auth phase. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth (phase 2). Create an OAuth app at https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
