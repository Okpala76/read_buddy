# Non-secret release configuration. Install as
# /home/gochi/read_buddy/release.env with mode 600.
POSTGRES_CONTAINER=read_buddy_postgres
POSTGRES_DATABASE=read_buddy
MIGRATION_ROLE=read_buddy_admin
BACKUP_ROLE=read_buddy_backup
BACKUP_DIR=/home/gochi/read_buddy/backups
BACKUP_REMOTE=read-buddy-offsite:production/database
LOCAL_RETENTION_DAYS=14
DATABASE_MAINTENANCE_LOCK_FILE=/home/gochi/read_buddy/.database-maintenance.lock
MIGRATION_LOCK_WAIT_SECONDS=0
RELEASE_STAGING_ROOT=/home/read_buddy_deploy/releases
BUNDLE_HMAC_KEY_FILE=/home/gochi/read_buddy/secrets/release-bundle-hmac
